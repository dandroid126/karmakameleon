<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer rules for Android 12 and newer; backup_rules.xml covers older versions. The login
     tokens (auth_tokens.xml, see PlatformModule.android.kt in shared) and the login WebView's Reddit session
     cookies must never leave the device. Everything else, such as settings and drafts, is still backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
