<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Lets the shell (adb, Perfetto, simpleperf) profile the app without making it debuggable. Phones before
             Android 10 ignore it. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
